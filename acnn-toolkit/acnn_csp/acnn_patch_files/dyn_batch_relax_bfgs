#!/bin/bash
set -e
export OMP_NUM_THREADS=1



source ../in.seed

prj="/data/home/mayuan/work/45.Ce-Mg-H/1.CSP/100GPa/acnn_new"
src="$prj/RSS/AIRSS"
pot_dir="$prj/POT/IT$IT"
pot=$(ls "$pot_dir"/model*/model-*|sort -V|tail -n 1)

exe="acnn_relax"
types="Ce,Mg,H"

press=100

xsf="$prj/XSF/IT$IT"
#min_bonds="Sr-Sr=1.2"
#bonds_scale="1.0"
if [ -d "$xsf" ];then
    rt=$(echo "scale=2; $(find $xsf -name "*limit*xsf"|wc -l) / ($(find $xsf -name "*limit*"|wc -l) + 0.1)"|bc)

    if (( $(echo "$rt > 0.75" | bc -l) )); then
        new_value=$(echo "scale=2;$bonds_scale * 0.95" | bc)
    else
        new_value=$(echo "scale=2;$bonds_scale * 1.05" | bc)
    fi

    sed -i "s/^bonds_scale=\"[0-9.]*\"/bonds_scale=\"$new_value\"/" ../in.seed
fi

optd="IT$IT"

# parallel hierarchy
frame="500"
group="50"
warp="10"
job_max=10


JOB_NAME="RELAXCeMgH"
NCORE="[DECISION]"
sign="[DECISION]"
base="[DECISION]"


function get_task(){
local NCORE="$1"
local sign="$2"
local base="$3"

TASK="""\
#!/bin/bash
#SBATCH --job-name="$JOB_NAME"
#SBATCH --partition=amd7513
##SBATCH --exclude=node02,node21,node07,node12

##SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node="$NCORE"
#SBATCH --cpus-per-task=1
#SBATCH --exclusive

source /data/home/mayuan/intel-2024/oneapi/intel2024_setvars.sh --force  > /dev/null
source /data/home/mayuan/bin/env_gcc-9.2.0 

export LD_LIBRARY_PATH=/data/home/mayuan/soft/libtorch/lib:\$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/data/home/mayuan/soft/OpenBLAS-0.3.28/anzhuang/lib:\$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/data/home/mayuan/soft/OpenBLAS-0.3.28-intel/anzhuang/lib:\$LD_LIBRARY_PATH


export MKL_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_DYNAMIC=false
export KMP_AFFINITY=granularity=fine,compact,1,0    # Thread affinity
export I_MPI_PIN_DOMAIN=auto        # process binding
export I_MPI_FABRICS=shm:ofi        # shared mem & open fabrics

#relax_lammps \"mpirun -np $NCORE "$exe"\" "$src"/"$sign".res "$pot" \""$types"\" "$press"

$(printf "$base")

#process_directory() {
#    local d=\$1
#    cd \$d || exit
#    echo \"check \$d\"
#    cabal poscar res < relax.vasp > \$d-out.res
#    H=\$(grep '!' relax.conv | tail -n 1 | awk -F'[ =]+' '{print \$3}')
#    rres "\$d-out.res" -s "\$d-out" -e "\$H" -p "$press"
#
#    UNSAFE=\$(acnn_bsafe -b \""$min_bonds"\" -x $bonds_scale | grep False |grep out | awk '{print \$1}')
#    if [ -n \"\$UNSAFE\" ]; then
#        echo UNSAFE
#
#        rm "\$d"-out.res
#
#        safe_traj -t relax.conv -b \"$min_bonds\" -x $bonds_scale | cabal poscar res > "\$d"-limitbonds.res
#
#        cp "\$d"-limitbonds.res ../LIM
#    fi
#    cd ..
#}
#
#export -f process_directory
#
#echo \"\${opt_dir[@]}\" | xargs -n 1 -P $NCORE bash -c 'timeout 30 bash -c \"process_directory \\\"\$@\\\"\" _' _

export opt_dir
acnn_ckrelax -b \"$min_bonds\" -x $bonds_scale -p "$press" -c $NCORE

echo CHECK_DONE
"""
echo "$TASK"
}







echo "DYNAMIC PARAMETERS"
echo ""
echo "  src         $src"
echo "  seed        $seed"
echo "  pot         $pot"
echo "  exe         $exe"
echo "  types       $types"
echo "  press       $press"
echo "  optd        $optd"
echo "  bonds       $min_bonds"
echo "  safe_bonds  $bonds_scale"
echo ""
echo "  frame       $frame"
echo "  group       $group"
echo "  warp        $warp"
echo ""
echo "TASK"
echo ""
get_task $NCORE $sign $base| sed 's/^/  /'

read -p "CHECK THE PARAMETERS: [y/n] " u_input

if [[ "$u_input" == "y" ]]; then
    echo ""
elif [[ "$u_input" == "n" ]]; then
    exit 0
else
    echo "Invalid input, [y/n] please."
    exit 1
fi








mkdir -p $optd
mkdir -p $optd/LIM
cd $optd

res_files=$(SRC_DIR="$src" FRAME_COUNT="$frame" python3 <<'PY'
import os
import random
import sys

src = os.environ.get("SRC_DIR", "")
target = int(os.environ.get("FRAME_COUNT", "0"))
if target <= 0:
    sys.exit(0)

dirs = [os.path.join(src, d) for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]
dirs.sort()

files_by_dir = []
total_files = 0
for directory in dirs:
    files = [os.path.join(directory, f) for f in os.listdir(directory) if f.endswith('.res')]
    files = [f for f in files if os.path.isfile(f) and os.path.getsize(f) > 0]
    if files:
        files_by_dir.append(files)
        total_files += len(files)

if not files_by_dir or total_files == 0:
    sys.exit(0)

random.seed()
frame = min(target, total_files)
dir_count = len(files_by_dir)
base = frame // dir_count
selected = []

if base >= 1:
    leftovers = []
    for files in files_by_dir:
        random.shuffle(files)
        take = min(base, len(files))
        selected.extend(files[:take])
        leftovers.extend(files[take:])
    remaining = frame - len(selected)
    if remaining > 0:
        random.shuffle(leftovers)
        selected.extend(leftovers[:remaining])
else:
    dirs_copy = files_by_dir[:]
    random.shuffle(dirs_copy)
    for files in dirs_copy:
        if len(selected) >= frame:
            break
        random.shuffle(files)
        if files:
            selected.append(files[0])

print('\n'.join(selected[:frame]))
PY
)
n_res=$(echo "$res_files" | wc -w)
echo "Total res files: $n_res"
echo ""

echo "$res_files" | shuf | split -l $group - group_




group_files=($(find . -name "group_*" | sort))
n_groups=${#group_files[@]}

full_warps=$(( n_groups / warp ))
remain=$(( n_groups % warp ))





for wi in $(seq 0 $((full_warps - 1))); do
    NUS=$(find LIM -type f -name "*limit*" | wc -l)
    echo "UNSAFE $NUS"
    if [ $NUS -gt 100 ]; then
        echo "STOP TOO MANY STRUCTURE EXCEEDING LIMIT"
        exit 0
    fi


    acnn_limitjob "$JOB_NAME" $job_max

    echo "TASK $wi"

    base=""
    back="opt_dir=\$(cat "

    for gi in $(seq 0 $((warp - 1))); do
        gn=$(( wi * warp + gi ))
        g=${group_files[$gn]}
        echo "  $g"

        base+="xargs -a $g cat |$exe -p $press -m $pot -t $types > relax_$(basename $g) 2>&1 & \n"
        back+="$g "
    done

    base+="wait \n"
    base+="$back"
    base+="| while read -r line; do basename "\$line" .res; done)\n\n"
    #base+="for d in \${opt_dir[@]};do\n"
    #printf "$base"
    get_task $warp "sign" "$base" > task$wi.sh
    chmod u+x task$wi.sh

    safe_sbatch task$wi.sh
done


if (( remain > 0 )); then
    NUS=$(find LIM -type f -name "*limit*" | wc -l)
    echo "UNSAFE $NUS"
    if [ $NUS -gt 100 ]; then
        echo "STOP TOO MANY STRUCTURE EXCEEDING LIMIT"
        exit 0
    fi

    acnn_limitjob "$JOB_NAME" $job_max

    echo "TASK $((full_warps + 1))"
    base=""
    back="opt_dir=\$(cat "
    for gi in $(seq 0 $((remain - 1))); do
        gn=$(( full_warps * warp + gi ))
        g=${group_files[$gn]}
        echo "  $g"

        base+="xargs -a $g cat |$exe -p $press -m $pot -t $types > relax_$(basename $g) 2>&1 & \n"
        back+="$g "
    done
    base+="wait \n"
    base+="$back"
    base+="| while read -r line; do basename "\$line" .res; done)\n\n"
    #base+="for d in \${opt_dir[@]};do\n"
    #printf "$base"
    get_task $remain "sign" "$base" > task$full_warps.sh
    chmod u+x task$full_warps.sh

    safe_sbatch task$full_warps.sh
fi

exit 0
