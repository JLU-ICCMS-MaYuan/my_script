#!/usr/bin/env python3
import sys
from datetime import datetime

def append_to_record(content):
    # Get current date and time
    current_time = datetime.now()
    current_date = current_time.strftime("%Y-%m-%d")
    current_time_str = current_time.strftime("%H:%M:%S")
    
    # Open file and append content (write in CSV format)
    with open("EXP.RECORD.csv", "a", newline='') as f:
        # Write header if file is empty
        f.write('  '.join(content) + '\n')

def main():
    # Check if any arguments were provided (first element is script name)
    if len(sys.argv) < 2:
        print("Usage: ./script.py content_to_log")
        sys.exit(1)
    
    # Get all arguments except the script name
    content = sys.argv[1:]
    
    # Call function to append content to file
    append_to_record(content)

if __name__ == "__main__":
    main()
