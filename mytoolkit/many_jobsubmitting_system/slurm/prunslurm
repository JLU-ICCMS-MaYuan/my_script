#!/bin/bash

# Get the optional filter name; default to the current directory if none is given.
name=${1:-$(pwd)}

# Run squeue once and store the output.
# This format uses a fixed width for each column, which is widely supported.
# %12A: JobID, %12P: Partition, %5t: State, %25R: Name, %8M: Time, %Z: WorkDir
squeue_output=$(squeue -u mayuan -h --format='%12A %12P %5t %25R %8M %Z')

echo "======== RUNNING ========"
# grep for the name to filter the list.
echo "$squeue_output" | grep " R " | grep --color=never "$name"

echo
echo "======== PENDING ========"
echo "$squeue_output" | grep " PD " | grep --color=never "$name"

echo
# Fix the logic for counting total jobs: filter first, then count.
total_count=$(echo "$squeue_output" | grep --color=never "$name" | wc -l)
echo "Total jobs matching '$name': $total_count"
